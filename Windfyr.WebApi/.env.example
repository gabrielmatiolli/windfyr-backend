# Copie este arquivo para .env e ajuste os valores para o seu ambiente
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=windfyr;User=root;Password=;
JWT__Key=troque_esta_chave_por_uma_string_muito_segura_com_32_ou_mais_caracteres
JWT__Issuer=windfyr-api
JWT__Audience=windfyr-client
JWT__ExpiresInMinutes=60
OPENWEATHER__APIKEY=sua_chave_openweathermap
OPENWEATHER__BASEURL=https://api.openweathermap.org
